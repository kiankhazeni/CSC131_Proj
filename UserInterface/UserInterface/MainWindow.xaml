<Window x:Class="UserInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitals"
        Height="650" 
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#123752">
            <StackPanel Margin="15,25,15,10">
                <TextBlock Text="Vitals Email Automation" Foreground="White" FontSize="16" 
                           FontWeight="Black" Margin="-2,0,0,30"/>
                
                <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}"/>
                <Button Content="Students" Command="{Binding ShowStudentsCommand}"/>
                <Button Content="Reminders" Command="{Binding ShowRemindersCommand}"/>
                <Button Content="Logs" Command="{Binding ShowLogsCommand}"/>
                <Button Content="Settings" Command="{Binding ShowSettingsCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,15,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#252525" Padding="15,10" CornerRadius="8" Margin="0,0,0,15">
                <TextBlock Text="{Binding CurrentSectionTitle}" Foreground="White" 
                           FontSize="20" FontWeight="Bold"/>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>