<Window x:Class="UserInterface.Views.AuthPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft Sign-In Required"
        Height="325"
        Width="460"
        MinHeight="310"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource VitalsWindowBackgroundBrush}"
        Icon="resources/assets/vitals_icon.ico">

    <Window.Resources>
        <Style x:Key="AuthPromptButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="Background" Value="{StaticResource VitalsFieldDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VitalsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource VitalsInfoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource VitalsPanelBrush}"
            BorderBrush="{StaticResource VitalsBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18"
            Margin="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Microsoft sign-in required"
                       Foreground="{StaticResource VitalsWhiteBrush}"
                       FontSize="19"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       x:Name="ModuleTextBlock"
                       Foreground="{StaticResource VitalsBodyTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2"
                       Text="Open the Microsoft device login page, then enter this code:"
                       Foreground="{StaticResource VitalsBodyTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="3"
                    Background="{StaticResource VitalsFieldDarkBrush}"
                    BorderBrush="{StaticResource VitalsInfoBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,10">

                <TextBox x:Name="CodeTextBox"
                         IsReadOnly="True"
                         TextAlignment="Center"
                         FontSize="24"
                         FontWeight="Bold"
                         FontFamily="Consolas"
                         Background="{StaticResource VitalsTransparentBrush}"
                         Foreground="{StaticResource VitalsWhiteBrush}"
                         BorderThickness="0"
                         CaretBrush="{StaticResource VitalsWhiteBrush}"/>
            </Border>

            <TextBlock Grid.Row="4"
                       x:Name="UrlTextBlock"
                       Foreground="{StaticResource VitalsMutedTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Copy Code"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="CopyCode_Click"
                        Style="{StaticResource AuthPromptButtonStyle}"/>

                <Button Content="Open Link"
                        Width="90"
                        Margin="0,0,8,0"
                        Click="OpenLink_Click"
                        Style="{StaticResource AuthPromptButtonStyle}"/>

                <Button Content="Done"
                        Width="75"
                        Click="Done_Click"
                        Style="{StaticResource AuthPromptButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>