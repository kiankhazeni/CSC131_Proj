<UserControl x:Class="UserInterface.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="8"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="10"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="120"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="CSV Sources" FontWeight="SemiBold"/>

				<TextBox Text="{Binding PreprodCsvPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,12,6"
                         Padding="6"/>

				<TextBox Text="{Binding AhaCsvPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"
                         Padding="6"/>

				<TextBlock Text="{Binding StatusMessage}"
                           Margin="0,6,0,0"
                           Foreground="#6B7280"/>
			</StackPanel>

			<Button Grid.Column="1"
                    Content="Load CSVs"
                    Command="{Binding LoadCsvCommand}"
                    Height="34"
                    Width="100"
                    VerticalAlignment="Top"
                    Margin="8,22,0,0"/>
		</Grid>

		<Expander Grid.Row="2"
                  Header="Columns"
                  IsExpanded="False"
                  Background="#F9FAFB">
			<WrapPanel Margin="10">

				<CheckBox x:Name="FirstNameCheckBox" Content="First Name" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="LastNameCheckBox" Content="Last Name" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="EmailCheckBox" Content="Email" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="PhoneCheckBox" Content="Phone" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="LocationNameCheckBox" Content="Location" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="GroupCheckBox" Content="Group" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="DateCheckBox" Content="Date" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="ReminderEmailSentCheckBox" Content="Reminder Sent" IsChecked="True"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>

				<CheckBox x:Name="MiddleNameCheckBox" Content="Middle Name" IsChecked="False"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="CourseCheckBox" Content="Course" IsChecked="False"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="AcuityRegistrationCheckBox" Content="Acuity Registration" IsChecked="False"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="AhaRegistrationCheckBox" Content="AHA Registration" IsChecked="False"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
				<CheckBox x:Name="StatusCheckBox" Content="Status" IsChecked="False"
                          Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,14,8"/>
			</WrapPanel>
		</Expander>

		<DataGrid x:Name="StudentsDataGrid"
                  Grid.Row="4"
                  ItemsSource="{Binding Students}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
			<DataGrid.Columns>
				<DataGridTextColumn x:Name="FirstNameColumn" Header="First Name" Binding="{Binding FirstName}" Width="120"/>
				<DataGridTextColumn x:Name="MiddleNameColumn" Header="Middle Name" Binding="{Binding MiddleName}" Width="120"/>
				<DataGridTextColumn x:Name="LastNameColumn" Header="Last Name" Binding="{Binding LastName}" Width="120"/>
				<DataGridTextColumn x:Name="EmailColumn" Header="Email" Binding="{Binding Email}" Width="220"/>
				<DataGridTextColumn x:Name="PhoneColumn" Header="Phone" Binding="{Binding Phone}" Width="130"/>
				<DataGridTextColumn x:Name="CourseColumn" Header="Course" Binding="{Binding Course}" Width="60"/>
				<DataGridTextColumn x:Name="DateColumn" Header="Date" Binding="{Binding Date}" Width="110"/>
				<DataGridTextColumn x:Name="AcuityRegistrationColumn" Header="Acuity Registration" Binding="{Binding AcuityRegistration}" Width="140"/>
				<DataGridTextColumn x:Name="AhaRegistrationColumn" Header="AHA Registration" Binding="{Binding AhaRegistration}" Width="140"/>
				<DataGridTextColumn x:Name="ReminderEmailSentColumn" Header="Reminder Sent" Binding="{Binding ReminderEmailSent}" Width="120"/>
				<DataGridTextColumn x:Name="LocationNameColumn" Header="Location" Binding="{Binding LocationName}" Width="120"/>
				<DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding Status}" Width="100"/>
				<DataGridTextColumn x:Name="GroupColumn" Header="Group" Binding="{Binding Group}" Width="240"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>