<UserControl x:Class="UserInterface.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#374151" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CSV Sources" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="0,0,0,10"/>

                    <Border Background="#1F2937" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="4" Margin="0,0,12,8">
                        <TextBox Text="{Binding PreprodCsvPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 CaretBrush="White" Padding="8"/>
                    </Border>

                    <Border Background="#1F2937" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                        <TextBox Text="{Binding AhaCsvPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 CaretBrush="White" Padding="8"/>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="2,6,0,0" Foreground="#9CA3AF"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Load CSVs" Command="{Binding LoadCsvCommand}"
                        Width="110" Height="36" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1A1A1A" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Expander Grid.Row="2" Header="Configure Columns" Foreground="White" 
                  Background="#374151" BorderBrush="#4B5563" BorderThickness="1">
            <Border Background="#1F2937" Padding="15">
                <WrapPanel>
                    <CheckBox x:Name="FirstNameCheckBox" Content="First Name" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="LastNameCheckBox" Content="Last Name" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="EmailCheckBox" Content="Email" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="PhoneCheckBox" Content="Phone" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="LocationNameCheckBox" Content="Location" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="GroupCheckBox" Content="Group" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="DateCheckBox" Content="Date" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="ReminderEmailSentCheckBox" Content="Reminder Sent" IsChecked="True" Foreground="#D1D5DB" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    
                    <CheckBox x:Name="AcuityRegistrationCheckBox" Content="Acuity Registration" IsChecked="False" Foreground="#9CA3AF" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="AhaRegistrationCheckBox" Content="AHA Registration" IsChecked="False" Foreground="#9CA3AF" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    
                    <CheckBox x:Name="MiddleNameCheckBox" Content="Middle Name" IsChecked="False" Foreground="#9CA3AF" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="CourseCheckBox" Content="Course" IsChecked="False" Foreground="#9CA3AF" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                    <CheckBox x:Name="StatusCheckBox" Content="Status" IsChecked="False" Foreground="#9CA3AF" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                </WrapPanel>
            </Border>
        </Expander>

        <Border Grid.Row="4" Background="#374151" CornerRadius="8" BorderBrush="#4B5563" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="StudentsDataGrid"
                      ItemsSource="{Binding Students}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      RowBackground="#374151"
                      AlternatingRowBackground="#3d4859"
                      Foreground="White"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      FontSize="13">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1F2937"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#4B5563"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="FirstNameColumn" Header="FIRST NAME" Binding="{Binding FirstName}" Width="127"/>
                    <DataGridTextColumn x:Name="LastNameColumn" Header="LAST NAME" Binding="{Binding LastName}" Width="125"/>
                    <DataGridTextColumn x:Name="EmailColumn" Header="EMAIL" Binding="{Binding Email}" Width="220"/>
                    <DataGridTextColumn x:Name="PhoneColumn" Header="PHONE" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn x:Name="DateColumn" Header="DATE" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn x:Name="ReminderEmailSentColumn" Header="REMINDER SENT" Binding="{Binding ReminderEmailSent}" Width="130"/>
                    <DataGridTextColumn x:Name="LocationNameColumn" Header="LOCATION" Binding="{Binding LocationName}" Width="120"/>
                    <DataGridTextColumn x:Name="GroupColumn" Header="GROUP" Binding="{Binding Group}" Width="*"/>
                    
                    <DataGridTextColumn x:Name="AcuityRegistrationColumn" Header="ACUITY REG." Binding="{Binding AcuityRegistration}" Visibility="Collapsed" Width="140"/>
                    <DataGridTextColumn x:Name="AhaRegistrationColumn" Header="AHA REG." Binding="{Binding AhaRegistration}" Visibility="Collapsed" Width="140"/>
                    
                    <DataGridTextColumn x:Name="MiddleNameColumn" Header="MIDDLE NAME" Binding="{Binding MiddleName}" Visibility="Collapsed" Width="120"/>
                    <DataGridTextColumn x:Name="CourseColumn" Header="COURSE" Binding="{Binding Course}" Visibility="Collapsed" Width="80"/>
                    <DataGridTextColumn x:Name="StatusColumn" Header="STATUS" Binding="{Binding Status}" Visibility="Collapsed" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>