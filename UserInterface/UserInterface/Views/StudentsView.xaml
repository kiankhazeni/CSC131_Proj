<UserControl x:Class="UserInterface.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CsvActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VitalsSidebarBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource VitalsSidebarHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource VitalsSidebarHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource VitalsSidebarPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="StudentsPageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="CSV Sources" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource VitalsWhiteBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RQI" Foreground="{StaticResource VitalsMutedTextBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource VitalsFieldBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding PreprodCsvPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource VitalsTransparentBrush}" Foreground="{StaticResource VitalsWhiteBrush}" BorderThickness="0"
                                 CaretBrush="{StaticResource VitalsWhiteBrush}" Padding="8"/>
                    </Border>
                    <Button Grid.Row="2" Grid.Column="3" Content="Browse" Command="{Binding BrowsePreprodCsvCommand}"
                            Width="90" Height="32" HorizontalAlignment="Right" Foreground="{StaticResource VitalsWhiteBrush}" Margin="0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="AHA" Foreground="{StaticResource VitalsMutedTextBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Row="4" Grid.Column="1" Background="{StaticResource VitalsFieldBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding AhaCsvPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource VitalsTransparentBrush}" Foreground="{StaticResource VitalsWhiteBrush}" BorderThickness="0"
                                 CaretBrush="{StaticResource VitalsWhiteBrush}" Padding="8"/>
                    </Border>
                    <Button Grid.Row="4" Grid.Column="3" Content="Browse" Command="{Binding BrowseAhaCsvCommand}"
                            Width="90" Height="32" HorizontalAlignment="Right" Foreground="{StaticResource VitalsWhiteBrush}" Margin="0"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource VitalsMutedTextBrush}" VerticalAlignment="Center"/>

                    <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset" Command="{Binding RestoreDefaultCsvPathsCommand}"
                                    Width="90" Style="{StaticResource CsvActionButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Export CSVs" Command="{Binding ExportCsvCommand}"
                                    Width="115" Style="{StaticResource CsvActionButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="Load CSVs" Command="{Binding LoadCsvCommand}"
                                    Width="105" Style="{StaticResource CsvActionButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Expander Grid.Row="2" Header="Configure Columns" Foreground="{StaticResource VitalsWhiteBrush}" 
                      Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1">
                <Border Background="{StaticResource VitalsFieldBrush}" Padding="15">
                    <DockPanel LastChildFill="True">
                        <Button Content="Reset Columns" Click="ResetColumns_Click" Width="115" Height="30" DockPanel.Dock="Right" Margin="12,0,0,10"/>
                        <UniformGrid Columns="4">
                            <CheckBox x:Name="FirstNameCheckBox" Content="First Name" IsChecked="True" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="MiddleNameCheckBox" Content="Middle Name" IsChecked="False" Foreground="{StaticResource VitalsMutedTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="LastNameCheckBox" Content="Last Name" IsChecked="True" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="EmailCheckBox" Content="Email" IsChecked="True" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="PhoneCheckBox" Content="Phone" IsChecked="False" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="CourseCheckBox" Content="Course" IsChecked="False" Foreground="{StaticResource VitalsMutedTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="DateCheckBox" Content="Date" IsChecked="True" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="LocationNameCheckBox" Content="Location" IsChecked="False" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="GroupCheckBox" Content="Group" IsChecked="False" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="StatusCheckBox" Content="Status" IsChecked="False" Foreground="{StaticResource VitalsMutedTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="AcuityRegistrationCheckBox" Content="Acuity Registration" IsChecked="True" Foreground="{StaticResource VitalsMutedTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="AhaRegistrationCheckBox" Content="AHA Registration" IsChecked="True" Foreground="{StaticResource VitalsMutedTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                            <CheckBox x:Name="ReminderEmailSentCheckBox" Content="Reminder Sent" IsChecked="True" Foreground="{StaticResource VitalsBodyTextBrush}" Checked="ColumnCheckBox_Changed" Unchecked="ColumnCheckBox_Changed" Margin="0,0,20,10"/>
                        </UniformGrid>
                    </DockPanel>
                </Border>
            </Expander>

            <Border Grid.Row="4" 
                    Background="{StaticResource VitalsPanelBrush}" 
                    CornerRadius="8" 
                    BorderBrush="{StaticResource VitalsBorderBrush}" 
                    BorderThickness="1" 
                    ClipToBounds="True" 
                    Height="455" 
                    MinHeight="420">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="StudentsDataGrid"
                              ItemsSource="{Binding Students}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{StaticResource VitalsTransparentBrush}"
                              RowBackground="{StaticResource VitalsPanelBrush}"
                              AlternatingRowBackground="{StaticResource VitalsPanelAltBrush}"
                              Foreground="{StaticResource VitalsWhiteBrush}"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              FontSize="13"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseLeftButtonUp="StudentsDataGrid_PreviewMouseLeftButtonUp"
                              PreviewMouseWheel="StudentsDataGrid_PreviewMouseWheel"    >
                        <DataGrid.Resources>
                            <Style x:Key="CellTextWithTooltipStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,10,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
                                <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
                            </Style>

                            <Style x:Key="StudentsScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Background" Value="{StaticResource VitalsTransparentBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="StudentsHorizontalThumbStyle" TargetType="{x:Type Thumb}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{StaticResource VitalsBorderBrush}"
                                                    CornerRadius="5"
                                                    Margin="2,2,2,2"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="{x:Type ScrollBar}">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Height" Value="13"/>
                                        <Setter Property="Background" Value="{StaticResource VitalsPanelBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderThickness="0,0,0,0">
                                                        <Grid Height="13">
                                                            <Track x:Name="PART_Track"
                                                                   Orientation="Horizontal"
                                                                   IsDirectionReversed="False">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                                                  Style="{StaticResource StudentsScrollPageButtonStyle}"/>
                                                                </Track.DecreaseRepeatButton>

                                                                <Track.Thumb>
                                                                    <Thumb Style="{StaticResource StudentsHorizontalThumbStyle}"/>
                                                                </Track.Thumb>

                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                              Style="{StaticResource StudentsScrollPageButtonStyle}"/>
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource VitalsFieldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource VitalsMutedTextBrush}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource VitalsBorderBrush}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VitalsWindowBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="FirstNameColumn" Header="FIRST NAME" Binding="{Binding FirstName}" Width="127"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="MiddleNameColumn" Header="MIDDLE NAME" Binding="{Binding MiddleName}" Visibility="Collapsed" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="LastNameColumn" Header="LAST NAME" Binding="{Binding LastName}" Width="125"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="EmailColumn" Header="EMAIL" Binding="{Binding Email}" Width="220"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="PhoneColumn" Header="PHONE" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="CourseColumn" Header="COURSE" Binding="{Binding Course}" Visibility="Collapsed" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="DateColumn" Header="DATE" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="LocationNameColumn" Header="LOCATION" Binding="{Binding LocationName}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="GroupColumn" Header="GROUP" Binding="{Binding Group}" Width="130"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="StatusColumn" Header="STATUS" Binding="{Binding Status}" Visibility="Collapsed" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="AcuityRegistrationColumn" Header="ACUITY REG." Binding="{Binding AcuityRegistration}" Visibility="Collapsed" Width="140"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="AhaRegistrationColumn" Header="AHA REG." Binding="{Binding AhaRegistration}" Visibility="Collapsed" Width="140"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" x:Name="ReminderEmailSentColumn" Header="REMINDER SENT" Binding="{Binding ReminderEmailSent}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
