<UserControl x:Class="UserInterface.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="Background" Value="{StaticResource VitalsWindowBackgroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLikeBooleanButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="Background" Value="{StaticResource VitalsFieldDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VitalsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource VitalsInfoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12" RequestBringIntoView="SettingsScrollViewer_RequestBringIntoView">
        <StackPanel>
            <Border Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Module Configuration" FontWeight="Bold" FontSize="18" Foreground="{StaticResource VitalsWhiteBrush}" Margin="0,0,0,8"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConfigCategories}" SelectedItem="{Binding SelectedConfigCategory}" Background="{StaticResource VitalsFieldBrush}" Foreground="{StaticResource VitalsWhiteBrush}"/>
                    </Grid>
                    <TextBlock Text="Click the dropdown to change category. Save changes before restarting modules"
                               Foreground="{StaticResource VitalsBodyTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>


                    <Border Background="{StaticResource VitalsFieldBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="390">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ConfigScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding ConfigItemsView}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource VitalsWhiteBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Margin="0,10,0,10"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="7"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource VitalsWhiteBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource VitalsMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Column="1">

                                                <Border Background="{StaticResource VitalsFieldDarkBrush}"
                                                        BorderBrush="{StaticResource VitalsBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBox Text="{Binding DisplayValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{StaticResource VitalsTransparentBrush}"
                                                             Foreground="{StaticResource VitalsWhiteBrush}"
                                                             BorderThickness="0"
                                                             Padding="8"
                                                             CaretBrush="{StaticResource VitalsWhiteBrush}"/>
                                                </Border>

                                                <Border Background="{StaticResource VitalsFieldDarkBrush}"
                                                        BorderBrush="{StaticResource VitalsBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Height="34">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid Height="34">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0"
                                                                 Text="••••••••••"
                                                                 IsReadOnly="True"
                                                                 VerticalAlignment="Center"
                                                                 Background="{StaticResource VitalsTransparentBrush}"
                                                                 Foreground="{StaticResource VitalsWhiteBrush}"
                                                                 BorderThickness="0"
                                                                 Padding="8"
                                                                 Cursor="Arrow">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSecretVisible}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>

                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{StaticResource VitalsTransparentBrush}"
                                                                 Foreground="{StaticResource VitalsWhiteBrush}"
                                                                 BorderThickness="0"
                                                                 Padding="8"
                                                                 CaretBrush="{StaticResource VitalsWhiteBrush}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSecretVisible}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>

                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.ToggleSecretVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="34"
                                                                Height="32"
                                                                Background="{StaticResource VitalsTransparentBrush}"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Padding="0">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource VitalsMutedTextBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="👁"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSecretVisible}" Value="True">
                                                                                <Setter Property="Text" Value="🙈"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <Button Command="{Binding DataContext.ToggleConfigBooleanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FieldLikeBooleanButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Content" Value="Disabled / False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding BooleanValue}" Value="True">
                                                                    <Setter Property="Content" Value="Enabled / True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ModuleConfigStatusMessage}" Foreground="{StaticResource VitalsBodyTextBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Reset" Command="{Binding ReloadAppPropertiesCommand}" Width="90" Style="{StaticResource SettingsButtonStyle}"/>
                        <Button Grid.Column="3" Content="Restore Defaults" Command="{Binding RestoreDefaultAppPropertiesCommand}" Width="130" Style="{StaticResource SettingsButtonStyle}"/>
                        <Button Grid.Column="5" Content="Save Module Config" Command="{Binding SaveAppPropertiesCommand}" Width="150" Style="{StaticResource SettingsButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{Binding AppPropertiesPath}" Foreground="{StaticResource VitalsMutedTextBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Module Run Commands" FontWeight="Bold" FontSize="18" Foreground="{StaticResource VitalsWhiteBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Do not modify fields unless you are confident. Changes may break the application"
                               Foreground="{StaticResource VitalsMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding AutomationModules}"
                              PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{StaticResource VitalsPanelBrush}"
                              RowBackground="{StaticResource VitalsPanelBrush}"
                              AlternatingRowBackground="{StaticResource VitalsPanelAltBrush}"
                              Foreground="{StaticResource VitalsWhiteBrush}"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              Height="120"
                              VerticalScrollBarVisibility="Disabled">
                        <DataGrid.Resources>
                            <Style x:Key="CellTextWithTooltipStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
                                <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource VitalsFieldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource VitalsBodyTextBrush}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VitalsWindowBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ENABLED" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" Header="NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" Header="COMMAND" Binding="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" Header="ARGUMENTS" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource CellTextWithTooltipStyle}" Header="STATUS" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Microsoft Sign-in Caches" FontWeight="Bold" FontSize="18" Foreground="{StaticResource VitalsWhiteBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Clear these when you need to sign in with a different Microsoft account"
                               Foreground="{StaticResource VitalsMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cache" Foreground="{StaticResource VitalsBodyTextBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AuthCacheItems}" SelectedItem="{Binding SelectedAuthCacheItem}" DisplayMemberPath="DisplayName" Background="{StaticResource VitalsFieldBrush}" Foreground="{StaticResource VitalsWhiteBrush}"/>
                        <Button Grid.Column="3" Content="Clear Cache" Command="{Binding ClearSelectedAuthCacheCommand}" Width="110" Style="{StaticResource SettingsButtonStyle}"/>
                        <Button Grid.Column="5" Content="Clear All" Command="{Binding ClearAllAuthCachesCommand}" Width="90" Style="{StaticResource SettingsButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{Binding AuthStatusMessage}" Foreground="{StaticResource VitalsBodyTextBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Log Display" FontWeight="Bold" FontSize="18" Foreground="{StaticResource VitalsWhiteBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Hidden logs will not be deleted. See the log folder for logs"
                               Foreground="{StaticResource VitalsMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Keep visible logs after restart" Foreground="{StaticResource VitalsBodyTextBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding RetainVisibleLogsBetweenSessions}" VerticalAlignment="Center" Cursor="Hand"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hide visible logs older than (hours)" Foreground="{StaticResource VitalsBodyTextBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource VitalsFieldBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBox Text="{Binding VisibleLogRetentionHours, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource VitalsTransparentBrush}" Foreground="{StaticResource VitalsWhiteBrush}" BorderThickness="0" Padding="8" CaretBrush="{StaticResource VitalsWhiteBrush}"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource VitalsPanelBrush}" BorderBrush="{StaticResource VitalsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding SettingsStatusMessage}" Foreground="{StaticResource VitalsBodyTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Grid.Column="1" Content="Set Current as Defaults" Command="{Binding SaveCurrentAsDefaultCommand}" Width="150" Style="{StaticResource SettingsButtonStyle}"/>
                        <Button Grid.Column="3" Content="Restore App Defaults" Command="{Binding ResetSettingsCommand}" Width="130" Style="{StaticResource SettingsButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{Binding SettingsFilePath}" Foreground="{StaticResource VitalsMutedTextBrush}" FontSize="11" Margin="0,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
