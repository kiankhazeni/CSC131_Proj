<UserControl x:Class="UserInterface.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">

            <Border Background="#374151"
                    BorderBrush="#4B5563"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Automation Status"
                                   FontSize="12"
                                   Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding AutomationStatusText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="Start" 
                            Command="{Binding StartAutomationCommand}" 
                            Width="90" 
                            Height="32" 
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="#10B981" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutomationStatusText}" Value="Running">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#1F2937" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="3" 
                            Content="Stop" 
                            Command="{Binding StopAutomationCommand}" 
                            Width="90" 
                            Height="32" 
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="#C10E21" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutomationStatusText}" Value="Stopped">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#1F2937" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="#374151" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Active Students" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding ActiveStudentsCount}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Background="#374151" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Pending Students" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding PendingStudentsCount}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Background="#374151" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Errors" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding ErrorCount}" FontSize="26" FontWeight="SemiBold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#374151" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="System Activity" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last student check:" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastStudentCheck}" Foreground="#E5E7EB"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last inbox check:" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastInboxCheck}" Foreground="#E5E7EB"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last reminder run:" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastReminderRun}" Foreground="#E5E7EB"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Next reminder run:" Foreground="#9CA3AF"/>
                            <TextBlock Grid.Column="1" Text="{Binding NextReminderRun}" Foreground="#E5E7EB"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#374151" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Recent Logs" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding RecentLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#4B5563" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding TimeText}" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}" Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Level}" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>