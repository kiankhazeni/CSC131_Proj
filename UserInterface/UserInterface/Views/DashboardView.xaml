<UserControl x:Class="UserInterface.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Border Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Automation Status"
                                   FontSize="12"
                                   Foreground="#6B7280"/>
                        <TextBlock Text="{Binding AutomationStatusText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Start"
                            Command="{Binding StartAutomationCommand}"
                            Width="90"
                            Height="32"
                            VerticalAlignment="Center"/>

                    <Button Grid.Column="3"
                            Content="Stop"
                            Command="{Binding StopAutomationCommand}"
                            Width="90"
                            Height="32"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Active Students" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding ActiveStudentsCount}" FontSize="26" FontWeight="SemiBold" Foreground="#111827"/>
                    </StackPanel>
                </Border>

                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Pending Students" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding PendingStudentsCount}" FontSize="26" FontWeight="SemiBold" Foreground="#111827"/>
                    </StackPanel>
                </Border>

                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Errors" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding ErrorCount}" FontSize="26" FontWeight="SemiBold" Foreground="#111827"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="System Activity"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last student check:" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastStudentCheck}" Foreground="#111827"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last inbox check:" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastInboxCheck}" Foreground="#111827"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last reminder run:" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastReminderRun}" Foreground="#111827"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Next reminder run:" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="{Binding NextReminderRun}" Foreground="#111827"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Recent Logs"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding RecentLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,8"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Source}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           DockPanel.Dock="Left"/>

                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="#6B7280"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="#374151"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>

                                            <TextBlock Text="{Binding Level}"
                                                       Foreground="#6B7280"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>