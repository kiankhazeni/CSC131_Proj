<Application x:Class="UserInterface.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UserInterface.Views"
             xmlns:viewModels="clr-namespace:UserInterface.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Centralized color palette for Interface -->
        <SolidColorBrush x:Key="VitalsWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="VitalsTransparentBrush" Color="Transparent"/>

        <SolidColorBrush x:Key="VitalsWindowBackgroundBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="VitalsHeaderPanelBrush" Color="#252525"/>
        <SolidColorBrush x:Key="VitalsSidebarBrush" Color="#123752"/>
        <SolidColorBrush x:Key="VitalsSidebarHoverBrush" Color="#1F4E73"/>
        <SolidColorBrush x:Key="VitalsSidebarPressedBrush" Color="#0F2E45"/>

        <SolidColorBrush x:Key="VitalsRedBrush" Color="#C10E21"/>
        <SolidColorBrush x:Key="VitalsGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="VitalsErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="VitalsErrorLightBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="VitalsWarningBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="VitalsInfoBrush" Color="#60A5FA"/>

        <SolidColorBrush x:Key="VitalsPanelBrush" Color="#374151"/>
        <SolidColorBrush x:Key="VitalsPanelAltBrush" Color="#3D4859"/>
        <SolidColorBrush x:Key="VitalsFieldBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="VitalsFieldDarkBrush" Color="#111827"/>
        <SolidColorBrush x:Key="VitalsFieldHoverBrush" Color="#243244"/>
        <SolidColorBrush x:Key="VitalsBorderBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="VitalsMutedTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="VitalsBodyTextBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="VitalsLightTextBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="VitalsThumbBrush" Color="#6B7280"/>


        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="Background" Value="{StaticResource VitalsFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VitalsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="1"
                                              Width="10"
                                              Height="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="{StaticResource VitalsMutedTextBrush}"
                                              Data="M 0 0 L 5 6 L 10 0 Z"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxBorder"
                                                Property="BorderBrush"
                                                Value="{StaticResource VitalsInfoBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="BoxBorder"
                                                Property="BorderBrush"
                                                Value="{StaticResource VitalsInfoBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="BoxBorder"
                                                Property="Opacity"
                                                Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="10,0,32,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource VitalsFieldBrush}"
                                    BorderBrush="{StaticResource VitalsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,4,0,0">
                                        <ScrollViewer Margin="2"
                                              SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup"
                                Property="MinHeight"
                                Value="40"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource VitalsFieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource VitalsPanelBrush}"/>
                            </Trigger>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource VitalsPanelBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource VitalsSidebarBrush}"/>
                                <Setter Property="Foreground"
                                Value="{StaticResource VitalsWhiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource VitalsWhiteBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBoxBorder"
                            Width="18"
                            Height="18"
                            Background="{StaticResource VitalsFieldBrush}"
                            BorderBrush="{StaticResource VitalsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                              Data="M 3 9 L 7 13 L 15 4"
                              Stroke="{StaticResource VitalsWhiteBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                Property="BorderBrush"
                                Value="{StaticResource VitalsInfoBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                Property="Background"
                                Value="{StaticResource VitalsFieldBrush}"/>
                                <Setter TargetName="CheckBoxBorder"
                                Property="BorderBrush"
                                Value="{StaticResource VitalsBorderBrush}"/>
                                <Setter TargetName="CheckMark"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:StudentsViewModel}">
            <views:StudentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:RemindersViewModel}">
            <views:RemindersView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

    </Application.Resources>
</Application>