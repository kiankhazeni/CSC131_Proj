package main;

import org.jsoup.Connection;
import org.jsoup.Jsoup;
import org.json.JSONArray;
import org.json.JSONObject;

import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.LinkedHashMap;

public class WebScraper {

    private static final String CLASS_ID = "20099433";
    private static final String ENROLLMENT_STATUS = "ENROLLED";
    private static final String STATUS = "IN_PROGRESS";
    private static final String SORT = "firstName,asc";

    private static final int PAGE_SIZE = 50;
    private static final int MAX_PAGES = 50;

    private static final String JWT_FILE = "atlas_jwt.txt";
    private static final String EXTID_FILE = "atlas_extid.txt";

    static class Student {
        String first, last, email;

        Student(String first, String last, String email) {
            this.first = n(first);
            this.last = n(last);
            this.email = n(email);
        }

        String key() {
            return (first + "|" + last + "|" + email).toLowerCase();
        }

        String toCsv() {
            return csv(first) + "," + csv(last) + "," + csv(email);
        }

        private static String n(String s) { return s == null ? "" : s.trim(); }

        private static String csv(String s) {
            if (s == null) return "";
            String v = s.trim();
            if (v.contains(",") || v.contains("\"") || v.contains("\n")) {
                v = v.replace("\"", "\"\"");
                return "\"" + v + "\"";
            }
            return v;
        }
    }

    public static void main(String[] args) {
        try {
            String jwt = readOneLine(JWT_FILE);
            String extId = readOneLine(EXTID_FILE);

            if (jwt.isEmpty()) {
                System.out.println("ERROR: atlas_jwt.txt missing or empty.");
                return;
            }
            if (extId.isEmpty()) {
                System.out.println("ERROR: atlas_extid.txt missing or empty.");
                return;
            }

            LinkedHashMap<String, Student> unique = new LinkedHashMap<String, Student>();

            for (int page = 0; page < MAX_PAGES; page++) {
                String url = buildUrl(page, PAGE_SIZE);

                Connection.Response resp = Jsoup.connect(url)
                        .userAgent("Mozilla/5.0")
                        .timeout(25000)
                        .ignoreContentType(true)
                        .maxBodySize(0)
                        .header("accept", "application/json")
                        .header("content-type", "application/json")
                        .header("origin", "https://atlas.heart.org")
                        .header("referer", "https://atlas.heart.org/")
                        .header("x-jwt-token", jwt)
                        .header("ext_id", extId)
                        .method(Connection.Method.GET)
                        .execute();

                if (resp.statusCode() != 200) {
                    System.out.println("ERROR: HTTP " + resp.statusCode() + " on page " + page);
                    System.out.println(resp.body());
                    return;
                }

                String body = resp.body();

        
                Files.write(Paths.get("students_page_" + page + ".json"),
                        body.getBytes(StandardCharsets.UTF_8));

                JSONObject root = new JSONObject(body);
                JSONObject data = root.optJSONObject("data");
                if (data == null) break;

                JSONObject studentsObj = data.optJSONObject("students");
                if (studentsObj == null) break;

                JSONArray items = studentsObj.optJSONArray("items");
                if (items == null || items.length() == 0) {
                    break;                 }

                for (int i = 0; i < items.length(); i++) {
                    JSONObject s = items.getJSONObject(i);

                    String first = s.optString("firstName", "");
                    String last  = s.optString("lastName", "");
                    String email = s.optString("emailId", ""); 

                    Student st = new Student(first, last, email);
                    if (!st.email.isEmpty() || (!st.first.isEmpty() && !st.last.isEmpty())) {
                        unique.putIfAbsent(st.key(), st);
                    }
                }

                if (items.length() < PAGE_SIZE) break; 
            }

       
            System.out.println("first,last,email");
            for (Student s : unique.values()) {
                System.out.println(s.toCsv());
            }
            System.out.println("Total unique: " + unique.size());

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private static String buildUrl(int page, int size) {
        return "https://atlas-api-gateway.heart.org/classManagement/v2/classes/" + CLASS_ID + "/students"
                + "?page=" + page
                + "&sort=" + SORT
                + "&size=" + size
                + "&enrollmentStatus=" + ENROLLMENT_STATUS
                + "&status=" + STATUS;
    }

    private static String readOneLine(String file) throws Exception {
        if (!Files.exists(Paths.get(file))) return "";
        return new String(Files.readAllBytes(Paths.get(file)), StandardCharsets.UTF_8)
                .replace("\r", "")
                .replace("\n", "")
                .trim();
    }
}
